#!/usr/bin/env python3
import json,os,sys,urllib.parse
scenario=os.environ.get("CRW_FORGE_SCENARIO","ready")
rule_shape=os.environ.get("CRW_FORGE_RULES","one")
if scenario.startswith("multi-"):
 _,rule_shape,scenario=scenario.split("-",2)
args=sys.argv[1:]; target=args[-1]
if os.environ.get("CRW_FORGE_LOG"): open(os.environ["CRW_FORGE_LOG"],"a").write(json.dumps(args)+"\n")
def out(v):
 patch=json.loads(os.environ.get("CRW_FORGE_PATCH","null"))
 if patch:
  if args[:2]==["api","graphql"]:
   query=next(x[6:] for x in args if x.startswith("query="))
   endpoint="reviews" if "\n    reviews(" in query else "comments" if "\n    comments(" in query else "reviewThreads"
  else:
   endpoint="pull" if "/pulls/" in target else "jobs" if "/jobs" in target else "runs" if "/actions/runs" in target else "checks" if "/check-runs" in target else "statuses" if "/status" in target else "other"
  if endpoint==patch["endpoint"]:
   path=patch["path"]
   if not path: v=None if patch["delete"] else patch["value"]
   else:
    node=v
    for key in path[:-1]: node=node[key]
    if patch["delete"]:
     if isinstance(node,dict): node.pop(path[-1],None)
     else: del node[path[-1]]
    else: node[path[-1]]=patch["value"]
 print(json.dumps(v,separators=(",",":")))
if args[:2]==["api","graphql"]:
 if rule_shape!="one" and scenario=="unknown": print("gh: forbidden (HTTP 403)",file=sys.stderr);sys.exit(1)
 q=next((x[6:] for x in args if x.startswith("query=")),"")
 field="reviewThreads";nodes=[]
 if "\n    reviews(" in q:
  field="reviews"
  if scenario=="rich": nodes=[{"id":"R1","state":"APPROVED","url":"u/R1","body":"review text","submittedAt":"t","author":{"login":"r"}}]
 elif "\n    comments(" in q:
  field="comments"
  if scenario=="rich": nodes=[{"id":"C1","url":"u/C1","body":"comment text","createdAt":"t","author":{"login":"c"}}]
 else:
  count=1 if scenario in ("unresolved","late") else 0
  if scenario=="late":count=2
  if scenario=="seven":count=7
  if scenario=="rich":count=1
  nodes=[{"id":f"T{i}","isResolved":scenario!="unresolved","isOutdated":False,"path":"a","line":i,"originalLine":None,"comments":{"nodes":[{"url":f"u/T{i}","author":{"login":"r"},"body":"x","createdAt":"t"}]}} for i in range(1,count+1)]
 out({"data":{"repository":{"pullRequest":{field:{"totalCount":len(nodes),"pageInfo":{"hasNextPage":False,"endCursor":None},"nodes":nodes}}}}});sys.exit()
path=target.partition('?')[0]
if "/pulls/" in path and scenario=="unreadable": print("gh: forbidden (HTTP 403)",file=sys.stderr);sys.exit(1)
if "/pulls/" in path: out({"number":7,"html_url":"u","state":"open","merged":False,"draft":False,"head":{"sha":"a"*40},"base":{"sha":"b"*40,"ref":"dev"},"mergeable":True,"mergeable_state":"clean"})
elif "/git/ref/" in path: out({"ref":"refs/heads/dev"})
elif "/rules/branches/" in path:
 if rule_shape=="one" and scenario=="unknown": print("gh: forbidden (HTTP 403)",file=sys.stderr);sys.exit(1)
 required=[{"context":"dev-gate"}]
 if scenario=="rich": required=[{"context":"external","integration_id":43},{"context":"dev-gate","integration_id":42}]
 rules=[{"type":"required_status_checks","parameters":{"strict_required_status_checks_policy":False,"required_status_checks":required}}]
 if rule_shape in ("two","three","duplicate"):
  rules.append({"type":"pull_request","parameters":{"required_review_thread_resolution":True}})
 if rule_shape=="three": rules.append({"type":"non_fast_forward"})
 if rule_shape=="duplicate": rules.append(rules[0])
 if "CRW_FORGE_RULES_JSON" in os.environ:
  rules=json.loads(os.environ["CRW_FORGE_RULES_JSON"])
  if not isinstance(rules,list): out(rules);sys.exit()
  rule_shape="custom"
 if rule_shape=="one": out(rules)
 else:
  params=dict(urllib.parse.parse_qsl(target.partition('?')[2]));page=int(params.get("page",1));size=int(params.get("per_page",100))
  out(rules[(page-1)*size:page*size] if size>0 else rules)

elif "/actions/runs/1/jobs" in path: out({"total_count":1,"jobs":[{"id":11,"name":"dev-gate","run_attempt":1,"status":"completed","conclusion":"success","html_url":"job","started_at":None,"completed_at":None}]})
elif "/actions/runs/2/jobs" in path: out({"total_count":1,"jobs":[{"id":12,"name":"old-gate","run_attempt":1,"status":"completed","conclusion":"cancelled","html_url":"old-job","started_at":None,"completed_at":None}]})
elif "/actions/runs" in path:
 runs=[{"id":1,"name":"CI","head_sha":"a"*40,"workflow_id":100,"event":"pull_request","html_url":"run","run_started_at":"2026-01-02"}]
 if scenario=="rich": runs.append({"id":2,"name":"CI","head_sha":"a"*40,"workflow_id":100,"event":"pull_request","html_url":"old-run","conclusion":"cancelled","run_started_at":"2026-01-01"})
 out({"total_count":len(runs),"workflow_runs":runs})
elif "/check-runs" in path:
 checks=[{"id":11,"name":"dev-gate","head_sha":"a"*40,"status":"completed","conclusion":"success","app":{"id":42,"slug":"actions"}}]
 if scenario=="rich": checks.append({"id":13,"name":"external","head_sha":"a"*40,"status":"completed","conclusion":"success","app":{"id":43,"slug":"external"},"html_url":"check","started_at":"t","completed_at":"t"})
 out({"total_count":len(checks),"check_runs":checks})
elif path.endswith("/status"):
 statuses=[{"context":"status","state":"success","target_url":"status-url","updated_at":"t"}] if scenario=="rich" else []
 out({"total_count":len(statuses),"statuses":statuses})
else: print("unexpected "+target,file=sys.stderr);sys.exit(1)
