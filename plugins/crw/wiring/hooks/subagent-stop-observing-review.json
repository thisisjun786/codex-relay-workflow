{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/crw-runtime/current/bin/crw\" hook subagent-stop --leg subagent-stop-observing-review",
            "timeout": 10,
            "statusMessage": "(crw) Recording review verdict"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
