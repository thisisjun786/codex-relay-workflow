{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/crw-runtime/current/bin/crw\" hook user-prompt-submit --leg user-prompt-submit-delivering-background-completions",
            "timeout": 10,
            "statusMessage": "(crw) Delivering background completions"
          }
        ]
      }
    ]
  }
}
