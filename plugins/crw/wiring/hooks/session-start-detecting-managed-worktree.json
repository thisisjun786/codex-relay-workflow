{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/crw-runtime/current/bin/crw\" hook session-start --leg session-start-detecting-managed-worktree",
            "timeout": 10,
            "statusMessage": "(crw) Checking managed-worktree identity"
          }
        ]
      }
    ]
  }
}
