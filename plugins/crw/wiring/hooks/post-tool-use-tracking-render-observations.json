{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/crw-runtime/current/bin/crw\" hook post-tool-use --leg post-tool-use-tracking-render-observations",
            "timeout": 10,
            "statusMessage": "(crw) Tracking render observation"
          }
        ],
        "matcher": "^(view_image|browser:control-in-app-browser|chrome:control-chrome|computer-use:computer-use|apply_patch)$"
      }
    ]
  }
}
