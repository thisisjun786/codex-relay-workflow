{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/crw-runtime/current/bin/crw\" hook pre-tool-use --leg pre-tool-use-guarding-goal-complete",
            "timeout": 15,
            "statusMessage": "(crw) Gating lazy goal completion (E8)"
          }
        ],
        "matcher": "^update_goal$"
      }
    ]
  }
}
