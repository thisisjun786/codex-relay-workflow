{
  "group": "env",
  "scenarios": [
    {
      "id": "hook__session-start-announcing-map-affordance__codexclaw_cxc_override_spells_commands",
      "covers": [
        "K3/session-start-announcing-map-affordance",
        "K13/CODEXCLAW_CXC",
        "K5/hook-rendered"
      ],
      "note": "CODEXCLAW_CXC (trimmed) overrides how injected commands spell the CLI (cxc-resolve.ts:79).",
      "given": {
        "env": {
          "CODEXCLAW_CXC": "  /opt/bin/cxc-pinned  "
        }
      },
      "steps": [
        {
          "hook": "session-start-announcing-map-affordance",
          "stdin": {
            "hook_event_name": "SessionStart",
            "session_id": "rec-s1",
            "cwd": "${WS}",
            "source": "startup",
            "transcript_path": null
          }
        }
      ]
    },
    {
      "id": "hook__user-prompt-submit-checking-pabcd-trigger__codexclaw_cxc_override_in_directive",
      "covers": [
        "K3/user-prompt-submit-checking-pabcd-trigger",
        "K13/CODEXCLAW_CXC",
        "K5/hook-rendered"
      ],
      "note": "The phase directive after a chat `orchestrate P` names the overridden CLI.",
      "given": {
        "env": {
          "CODEXCLAW_CXC": "cxc-pinned"
        }
      },
      "steps": [
        {
          "hook": "session-start-bootstrapping-pabcd-state",
          "stdin": {
            "hook_event_name": "SessionStart",
            "session_id": "rec-s1",
            "cwd": "${WS}",
            "source": "startup"
          }
        },
        {
          "hook": "user-prompt-submit-checking-pabcd-trigger",
          "stdin": {
            "hook_event_name": "UserPromptSubmit",
            "session_id": "rec-s1",
            "cwd": "${WS}",
            "turn_id": "rec-t1",
            "prompt": "orchestrate P"
          }
        }
      ]
    },
    {
      "id": "mcp__subagent-config__catalog_list_reads_codex_models_cache_path",
      "covers": [
        "K10/tools/call/catalog_list",
        "K13/CODEX_MODELS_CACHE_PATH"
      ],
      "note": "With ocx absent, catalog_list reads the native catalog at CODEX_MODELS_CACHE_PATH instead of CODEX_HOME/models_cache.json (catalog.ts:60).",
      "given": {
        "env": {
          "CODEX_MODELS_CACHE_PATH": "${TMP}/elsewhere/models.json"
        },
        "stubs": {
          "ocx": null
        },
        "files": {
          "tmp/elsewhere/models.json": "{\"models\":[{\"slug\":\"rec-model-from-env-path\",\"display_name\":\"Rec Env Model\",\"supported_reasoning_levels\":[{\"effort\":\"low\"},{\"effort\":\"high\"}]}]}\n"
        }
      },
      "steps": [
        {
          "mcp": [
            {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "initialize",
              "params": {}
            },
            {
              "jsonrpc": "2.0",
              "id": 2,
              "method": "tools/call",
              "params": {
                "name": "catalog_list",
                "arguments": {}
              }
            }
          ]
        }
      ]
    },
    {
      "id": "cli__doctor__codex_bin_and_surface_env",
      "covers": [
        "K6/doctor/json",
        "K6/hooks/retrust",
        "K7/doctor",
        "K13/CODEX_BIN",
        "K13/CODEX_SURFACE",
        "K13/CODEX_APP_PORT",
        "K12/codex"
      ],
      "note": "CODEX_SURFACE, else CODEX_APP_PORT, sets doctor's activeSurface (doctor.ts:369). CODEX_BIN is read only by `hooks retrust` (codex-bin.ts:112 via hook-trust.ts:396): doctor keeps running the codex on PATH, retrust runs codex-pinned (see calls).",
      "given": {
        "stubs": {
          "codex-pinned": {
            "stdout": "default_mode_request_user_input  stable  true\ngoals  experimental  true\nhooks  stable  true\nmulti_agent  stable  true\n",
            "exit": 0
          },
          "codex": {
            "stdout": "default_mode_request_user_input  stable  true\ngoals  experimental  true\nhooks  stable  true\nmulti_agent  stable  true\n",
            "exit": 0
          }
        },
        "files": {
          "codex/config.toml": "[plugins.\"codexclaw@local\"]\nenabled = true\n"
        }
      },
      "steps": [
        {
          "cli": [
            "doctor",
            "--json"
          ],
          "env": {
            "CODEX_BIN": "${STUBS}/codex-pinned",
            "CODEX_SURFACE": "cli"
          }
        },
        {
          "cli": [
            "doctor",
            "--json"
          ],
          "env": {
            "CODEX_APP_PORT": "4500"
          }
        },
        {
          "cli": [
            "hooks",
            "retrust",
            "--key",
            "codexclaw@local",
            "--bootstrap-ok"
          ],
          "env": {
            "CODEX_BIN": "${STUBS}/codex-pinned"
          }
        }
      ]
    },
    {
      "id": "cli__map__codexclaw_python_runs_repomap_with_it",
      "covers": [
        "K6/map/run",
        "K13/CODEXCLAW_PYTHON",
        "K13/CODEXCLAW_MAP_BOOTSTRAP",
        "K12/python3"
      ],
      "note": "CODEXCLAW_PYTHON runs repomap.py with that interpreter (bin/codexclaw.mjs:338); CODEXCLAW_MAP_BOOTSTRAP=1 opts into creating the repo-map venv under CODEXCLAW_HOME with the python on PATH (bin/codexclaw.mjs:386), here a stub that fails.",
      "given": {
        "stubs": {
          "py-pinned": {
            "stdout": "# repo map (stub)\n",
            "exit": 0
          },
          "python3": {
            "stderr": "stub python3: venv unavailable\n",
            "exit": 1
          }
        }
      },
      "steps": [
        {
          "cli": [
            "map",
            "."
          ],
          "env": {
            "CODEXCLAW_PYTHON": "${STUBS}/py-pinned"
          }
        },
        {
          "cli": [
            "map",
            "."
          ],
          "env": {
            "CODEXCLAW_MAP_BOOTSTRAP": "1"
          }
        }
      ]
    }
  ]
}
