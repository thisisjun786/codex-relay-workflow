      },
      {
        "kind": "eq",
        "path": [
          "status",
          "firingRecordAbsence",
          "candidates",
          0,
          "cause"
        ],
        "value": "adapter_cannot_run"
      },
      {
        "kind": "eq",
        "path": [
          "status",
          "firingRecordAbsence",
          "candidates",
          1,
          "cause"
        ],
        "value": "settings_absent"
      }
    ]
