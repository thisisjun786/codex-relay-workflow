{
  "given": {
    "settings": false,
    "relay": {
      "stdout": "{\"decision\": \"release\", \"state\": \"unmanaged\", \"observation\": \"unmanaged\", \"reason\": \"No marker names this workspace.\", \"assignmentId\": null, \"counters\": {}, \"recordedAs\": null, \"hook_output\": {}}"
    },
    "files": {
      "hooks.json": "{\"hooks\": {\"Stop\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"${PYTHON} ${HOME}/completion_hook.py ${HOME}/crw-completion-hook.json\", \"timeout\": 10}]}]}}"
    }
  },
  "run": {
    "kind": "status"
  },
  "expect": {
    "exit": 0,
