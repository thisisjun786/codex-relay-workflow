{
  "given": {
    "settings": false,
    "files": {
      "hooks.json": "{\"hooks\": {\"Stop\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"${PYTHON} ${ENTRY} ${HOME}/a.json\", \"timeout\": 10}]}, {\"hooks\": [{\"type\": \"command\", \"command\": \"${PYTHON} ${ENTRY} ${HOME}/b.json\", \"timeout\": 10}]}]}}"
    }
  },
  "run": {
    "kind": "status"
  },
  "expect": {
    "exit": 0,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "status",
          "configuration",
          "value"
        ],
        "value": "registrations_name_different_settings"
      },
      {
        "kind": "contains",
        "path": [
          "status",
          "configuration",
          "evidence"
        ],
        "value": "a.json"
      },
      {
        "kind": "contains",
        "path": [
          "status",
          "configuration",
          "evidence"
        ],
        "value": "b.json"
      },
      {
        "kind": "eq",
        "path": [
          "status",
          "relayExecutable",
          "value"
        ],
        "value": "not_read"
      }
    ]
  }
}
