{
  "given": {
    "settings": false,
    "files": {
      "crw-completion-hook.json": "{\"configVersion\": 1, \"event\": \"Stop\", \"relayExecutable\": \"codex-session-relay\", \"markerRoot\": \"${HOME}/marker\", \"dbPath\": null, \"mode\": \"observe\", \"timeoutSeconds\": 5, \"journalRoot\": \"${HOME}/journal\", \"journalPolicy\": \"every_invocation\", \"installedBy\": \"CRW-100\", \"isolationAssertedBy\": null}"
    }
  },
  "run": {
    "kind": "status"
  },
  "expect": {
    "exit": 0,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "status",
          "configuration",
          "value"
        ],
        "value": "config_malformed"
      },
      {
        "kind": "regex",
        "path": [
          "status",
          "configuration",
          "evidence"
        ],
        "value": "^[^;]*absolute"
      }
    ]
  }
}
