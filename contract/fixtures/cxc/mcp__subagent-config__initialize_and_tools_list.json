                      },
                      "model": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "effort": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          null
                        ]
                      },
                      "fallback": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "description": "Optional first fallback. Null clears; omitted nested effort inherits existing fallback effort or session effort.",
