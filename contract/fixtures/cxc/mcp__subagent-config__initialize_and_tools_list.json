                            "enum": [
                              "low",
                              "medium",
                              "high",
                              "xhigh",
                              null
                            ]
                          }
                        },
                        "additionalProperties": false
                      },
                      "promptOverride": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "role"
                    ],
                    "additionalProperties": false
                  }
                },
