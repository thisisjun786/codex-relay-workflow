{
  "oracle": "v0.2.40 3c1459acadeb1906d97c00a598e1457327ae372d",
  "covers": [
    "K3/session-start-healing-declared-features",
    "K5/hook-rendered",
    "K12/codex",
    "K8/codex-home/codexclaw-self-heal.json",
    "A/config-guard/self-heal.test.ts"
  ],
  "note": "The soft flag reads false: self-heal runs `codex features enable default_mode_request_user_input`, says it lands from the NEXT session, and writes the marker (healedKeys, cachedKeys, config mtime); no manifest means no ownership record.",
  "given": {
    "files": {
      "codex/config.toml": "model = \"gpt-5.5\"\n\n[features]\nhooks = true\n"
    },
    "stubs": {
      "codex": {
        "stdout": "default_mode_request_user_input  under development  false\ngoals                            stable             true\nhooks                            stable             true\nmulti_agent                      stable             true\nmulti_agent_v2                   experimental       false\nplugin_hooks                     stable             false\n",
        "exit": 0
      }
    }
  },
  "run": {
    "kind": "cxc",
    "steps": [
      {
        "hook": "session-start-healing-declared-features",
        "stdin": {
          "hook_event_name": "SessionStart",
          "session_id": "rec-s1",
          "cwd": "${WS}",
          "source": "startup",
          "model": "gpt-5.5",
          "transcript_path": null
        }
      }
    ]
  },
  "expect": {
    "exit": 0,
    "steps": [
      {
        "exit": 0,
        "stdout_form": "json-line",
        "stdout_json": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "[codexclaw] Enabled the codex feature flag(s) codexclaw declares: default_mode_request_user_input. The tool list is fixed when a session starts, so anything they expose becomes available from the NEXT session, not this one.\n"
          }
        },
        "stderr": ""
      }
    ],
    "tree": {
      "codex/codexclaw": {
        "type": "dir",
        "mode": "0700"
      },
      "codex/codexclaw-self-heal.json": {
        "type": "file",
        "mode": "0644",
        "form": "json-pretty",
        "json": {
          "checkedAt": "<TS>",
          "allEnabled": true,
          "healedKeys": [
            "default_mode_request_user_input"
          ],
          "cachedKeys": [
            "default_mode_request_user_input"
          ],
          "configMtimeMs": "<MS>"
        }
      },
      "codex/config.toml": {
        "type": "file",
        "mode": "0644",
        "form": "text",
        "text": "model = \"gpt-5.5\"\n\n[features]\nhooks = true\n"
      }
    },
    "calls": [
      {
        "cmd": "codex",
        "argv": [
          "features",
          "list"
        ],
        "cwd": "${WS}"
      },
      {
        "cmd": "codex",
        "argv": [
          "features",
          "enable",
          "default_mode_request_user_input"
        ],
        "cwd": "${WS}"
      }
    ]
  }
}
