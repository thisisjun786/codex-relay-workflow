      },
      {
        "exit": 0,
        "stdout_form": "text",
        "stdout": "reset --state: removed 0 path(s) (nothing to remove)\n",
        "stderr": ""
      }
    ],
    "tree": {
      "ws/keep.txt": {
        "type": "file",
        "mode": "0644",
        "form": "text",
