      "ws/.codexclaw/sessions/rec-s1.json": "{\"phase\":\"B\"}\n",
      "ws/.codexclaw/sessions/rec-s2.json": "{\"phase\":\"P\"}\n",
      "ws/keep.txt": "outside\n"
