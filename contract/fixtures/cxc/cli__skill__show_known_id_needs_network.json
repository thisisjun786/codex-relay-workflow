{
  "oracle": "v0.2.40 3c1459acadeb1906d97c00a598e1457327ae372d",
  "covers": [
    "K6/skill/show",
    "K14/skill-search",
    "A/skill-search/cli.test.ts",
    "K13/CODEXCLAW_HOME"
  ],
  "note": "`skill show` of a cached id fetches the SKILL.md body fresh; offline that fetch fails and the CLI exits 1 with 'skill-search error'.",
  "given": {
    "files": {
      "cxc/skill-cache/jaw-aHR0cHM6Ly9yYXcuZ2l0aHVi.cache": "{\n  \"skills\": {\n    \"telegram-send\": {\n      \"name\": \"Telegram Send\",\n      \"description\": \"send telegram messages\",\n      \"category\": \"communication\",\n      \"requires\": {\n        \"bins\": [\n          \"curl\"\n        ]\n      }\n    },\n    \"tdd\": {\n      \"name\": \"TDD\",\n      \"description\": \"test driven development loop\",\n      \"superseded_by\": \"dev-testing\"\n    },\n    \"dev-testing\": {\n      \"name\": \"Dev Testing\",\n      \"description\": \"testing discipline for development\",\n      \"status\": \"active\"\n    }\n  }\n}\n"
    }
  },
  "run": {
    "kind": "cxc",
    "steps": [
      {
        "cli": [
          "skill",
          "show",
          "tdd"
        ]
      }
    ]
  },
  "expect": {
    "exit": 1,
    "steps": [
      {
        "exit": 1,
        "stdout_form": "empty",
        "stderr": "skill-search error: fetch failed\n"
      }
    ],
    "tree": {
      "cxc/skill-cache": {
        "type": "dir",
        "mode": "0755"
      },
      "cxc/skill-cache/jaw-aHR0cHM6Ly9yYXcuZ2l0aHVi.cache": {
        "type": "file",
        "mode": "0644",
        "form": "json-pretty",
        "json": {
          "skills": {
            "telegram-send": {
              "name": "Telegram Send",
              "description": "send telegram messages",
              "category": "communication",
              "requires": {
                "bins": [
                  "curl"
                ]
              }
            },
            "tdd": {
              "name": "TDD",
              "description": "test driven development loop",
              "superseded_by": "dev-testing"
            },
            "dev-testing": {
              "name": "Dev Testing",
              "description": "testing discipline for development",
              "status": "active"
            }
          }
        }
      }
    },
    "calls": [
      {
        "cmd": "fetch",
        "argv": [
          "GET",
          "https://raw.githubusercontent.com/lidge-jun/cli-jaw-skills/main/tdd/SKILL.md"
