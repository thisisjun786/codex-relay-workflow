{
  "given": {},
  "run": {
    "kind": "cli",
    "steps": [
      {
        "id": "bind",
        "argv": [
          "linkage-bind",
          "--role",
          "parent",
          "--scope",
          "PRJ-A",
          "--task",
          "task-alpha",
          "--host",
          "host-a"
        ]
      },
      {
        "id": "request",
        "argv": [
          "merge-turn-request",
          "--repository",
          "owner/repo",
          "--base-ref",
          "dev",
          "--project",
          "PRJ-A",
          "--task",
          "task-alpha",
          "--host",
          "host-a",
          "--head",
          "head-a",
          "--ready"
        ]
      },
      {
        "id": "bad",
        "argv": [
          "merge-turn-acknowledge",
          "--turn",
          {
            "$step": "request",
            "path": [
              "stdout_json",
              "turnId"
            ]
          },
          "--actor",
          "task-alpha",
          "--grant",
          "mtg-somethingelse",
          "--evidence",
          "I still had the old one"
        ]
      }
    ]
  },
  "expect": {
    "exit": 2,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "steps",
          "bad",
          "exit"
        ],
        "value": 2
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "bad",
          "stdout_json",
          "reason"
        ],
        "value": "merge_turn_not_held"
      }
    ]
  }
}
