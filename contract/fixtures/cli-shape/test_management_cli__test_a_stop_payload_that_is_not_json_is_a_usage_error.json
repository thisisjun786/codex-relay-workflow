{
  "given": {},
  "run": {
    "kind": "cli",
    "steps": [
      {
        "id": "guard",
        "argv": [
          "guard-evaluate",
          "--marker-root",
          "${HOME}/markers"
        ],
        "stdin": "not json"
      }
    ]
  },
  "expect": {
    "exit": 4,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "steps",
          "guard",
          "exit"
        ],
        "value": 4
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "guard",
          "stdout_json",
          "error"
        ],
        "value": "usage"
      }
    ]
  }
}
