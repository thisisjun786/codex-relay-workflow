{
  "given": {},
  "run": {
    "kind": "cli",
    "steps": [
      {
        "id": "both",
        "argv": [
          "merge-turn-show",
          "--parent-task",
          "task-alpha",
          "--repository",
          "owner/repo",
          "--base-ref",
          "dev"
        ]
      },
      {
        "id": "missing_base",
        "argv": [
          "merge-turn-show",
          "--repository",
          "owner/repo"
        ]
      },
      {
        "id": "none",
        "argv": [
          "merge-turn-show"
        ]
      }
    ]
  },
  "expect": {
    "exit": 2,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "steps",
          "both",
          "exit"
        ],
        "value": 2
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "both",
          "stdout_json",
          "reason"
        ],
        "value": "bad_invocation"
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "missing_base",
          "exit"
        ],
        "value": 2
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "missing_base",
          "stdout_json",
          "reason"
        ],
        "value": "bad_invocation"
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "none",
          "stdout_json",
          "reason"
        ],
        "value": "bad_invocation"
      }
    ]
  }
}
