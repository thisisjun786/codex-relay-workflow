{
  "given": {},
  "run": {
    "kind": "cli",
    "steps": [
      {
        "id": "bind",
        "argv": [
          "linkage-bind",
          "--role",
          "parent",
          "--scope",
          "PRJ-A",
          "--task",
          "task-alpha",
          "--host",
          "host-a"
        ]
      },
      {
        "id": "request",
        "argv": [
          "merge-turn-request",
          "--repository",
          "owner/repo",
          "--base-ref",
          "dev",
          "--project",
          "PRJ-A",
          "--task",
          "task-alpha",
          "--host",
          "host-a",
          "--head",
          "head-a",
          "--ready"
        ]
      },
      {
        "id": "ack",
        "argv": [
          "merge-turn-acknowledge",
          "--turn",
          {
            "$step": "request",
            "path": [
              "stdout_json",
              "turnId"
            ]
          },
          "--actor",
          "task-alpha",
          "--grant",
          {
            "$step": "request",
            "path": [
              "stdout_json",
              "grant",
              "grantId"
            ]
          },
          "--evidence",
          "read it and re-checked the head"
        ]
      },
      {
        "id": "check",
        "argv": [
          "merge-turn-check",
          "--turn",
          {
            "$step": "request",
            "path": [
              "stdout_json",
              "turnId"
            ]
          },
          "--actor",
          "task-alpha",
          "--head-sha",
          "head-moved",
          "--base-sha",
          "base-0",
          "--checks",
          "[{\"runId\": \"run-1\", \"name\": \"dev-gate\", \"headSha\": \"head-a\", \"conclusion\": \"success\", \"attempt\": 1}]",
          "--review",
          "{\"hasNextPage\": false, \"pagesRead\": 1, \"totalCount\": 1, \"threadsSeen\": [\"thread-1\"], \"unresolved\": 0}"
        ]
      }
    ]
  },
  "expect": {
    "exit": 2,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "steps",
          "bind",
          "exit"
        ],
        "value": 0
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "ack",
          "exit"
        ],
        "value": 0
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "check",
          "exit"
        ],
        "value": 2
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "check",
          "stdout_json",
          "error"
        ],
        "value": "refused"
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "check",
          "stdout_json",
          "reason"
        ],
        "value": "merge_candidate_moved"
      }
    ]
  }
}
