{
  "given": {},
  "run": {
    "kind": "cli",
    "steps": [
      {
        "id": "guard",
        "argv": [
          "guard-evaluate",
          "--marker-root",
          "${HOME}/markers",
          "--mode",
          "hold",
          "--no-record"
        ],
        "stdin": {
          "cwd": "${HOME}/workspace",
          "session_id": "01child-task",
          "turn_id": "turn-dispatch-1",
          "stop_hook_active": false,
          "hook_event_name": "Stop",
          "last_assistant_message": "All done, the work is complete."
        }
      }
    ]
  },
  "expect": {
    "exit": 4,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "steps",
          "guard",
          "exit"
        ],
        "value": 4
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "guard",
          "stdout_json",
          "error"
        ],
        "value": "usage"
      },
      {
        "kind": "contains",
        "path": [
          "steps",
          "guard",
          "stdout_json",
          "detail"
        ],
        "value": "--no-record"
      }
    ]
  }
}
