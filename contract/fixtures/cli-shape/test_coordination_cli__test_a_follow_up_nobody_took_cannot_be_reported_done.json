{
  "given": {},
  "run": {
    "kind": "cli",
    "steps": [
      {
        "id": "bind",
        "argv": [
          "linkage-bind",
          "--role",
          "parent",
          "--scope",
          "PRJ-A",
          "--task",
          "task-alpha",
          "--host",
          "host-a"
        ]
      },
      {
        "id": "bind_b",
        "argv": [
          "linkage-bind",
          "--role",
          "parent",
          "--scope",
          "PRJ-B",
          "--task",
          "task-beta",
          "--host",
          "host-b"
        ]
      },
      {
        "id": "peer",
        "argv": [
          "linkage-peer",
          "--left-project",
          "PRJ-A",
          "--left-task",
          "task-alpha",
          "--left-host",
          "host-a",
          "--right-project",
          "PRJ-B",
          "--right-task",
          "task-beta",
          "--right-host",
          "host-b"
        ]
      },
      {
        "id": "propose",
        "argv": [
          "region-propose",
          "--repository",
          "owner/repo",
          "--revision",
          "rev-1",
          "--path",
          "src/a.py",
          "--kind",
          "file",
          "--left-project",
          "PRJ-A",
          "--right-project",
          "PRJ-B",
          "--peer-link",
          {
            "$step": "peer",
            "path": [
              "stdout_json",
              "linkId"
            ]
          },
          "--task",
          "task-alpha",
          "--constraint",
          "keep the signature"
        ]
      },
      {
        "id": "follow",
        "argv": [
          "region-followup",
          "--agreement",
          {
            "$step": "propose",
            "path": [
              "stdout_json",
              "agreementId"
            ]
          },
          "--trigger",
          "a temporary duplicate implementation",
          "--acceptance",
          "the duplicate is gone",
          "--recorded-by",
          "task-alpha",
          "--issue-ref",
          "CRW-200"
        ]
      },
      {
        "id": "settle",
        "argv": [
          "region-followup-settle",
          "--followup",
          {
            "$step": "follow",
            "path": [
              "stdout_json",
              "followupId"
            ]
          },
          "--actor",
          "task-alpha",
          "--disposition",
          "done"
        ]
      }
    ]
  },
  "expect": {
    "exit": 2,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "steps",
          "bind_b",
          "exit"
        ],
        "value": 0
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "follow",
          "exit"
        ],
        "value": 0
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "settle",
          "exit"
        ],
        "value": 2
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "settle",
          "stdout_json",
          "reason"
        ],
        "value": "followup_unassigned"
      }
    ]
  }
}
