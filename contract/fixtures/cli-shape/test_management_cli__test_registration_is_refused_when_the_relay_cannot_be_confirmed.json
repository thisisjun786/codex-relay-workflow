{
  "given": {},
  "run": {
    "kind": "cli",
    "steps": [
      {
        "id": "declare",
        "argv": [
          "intent-declare",
          "--marker-root",
          "${HOME}/markers",
          "--workspace",
          "${HOME}/workspace",
          "--dispatch-request-id",
          "dispatch-1",
          "--issue",
          "REL-1"
        ]
      },
      {
        "id": "register",
        "argv": [
          "intent-register",
          "--marker-root",
          "${HOME}/markers",
          "--workspace",
          "${HOME}/workspace",
          "--assignment",
          {
            "$step": "declare",
            "path": [
              "stdout_json",
              "assignmentId"
            ]
          },
          "--relationship",
          "rel-0123456789abcdef",
          "--dispatch-request-id",
          "dispatch-1",
          "--db-path",
          "${HOME}/no-such-store.sqlite3"
        ]
      }
    ]
  },
  "expect": {
    "exit": 2,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "steps",
          "register",
          "exit"
        ],
        "value": 2
      },
      {
        "kind": "eq",
        "path": [
          "steps",
          "register",
          "stdout_json",
          "reason"
        ],
        "value": "unregistered_relationship"
      }
    ]
  }
}
