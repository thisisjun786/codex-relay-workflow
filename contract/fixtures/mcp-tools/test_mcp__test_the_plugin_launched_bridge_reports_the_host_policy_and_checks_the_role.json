{
  "given": {
    "policy": {
      "roles": {
        "child": {
          "model": "anthropic/claude-opus-5-5",
          "reasoningEffort": "xhigh"
        },
        "parent": {
          "model": "devin/swe-2",
          "reasoningEffort": "max"
        }
      }
    }
  },
  "run": {
    "kind": "mcp",
    "launcher": true,
    "steps": [
      {
        "tool": "get_capabilities",
        "id": "caps"
      },
      {
        "tool": "create_thread",
        "arguments": {
          "request_id": "wrong-child",
          "cwd": "${HOME}",
          "prompt": "READY",
          "model": "anthropic/claude-opus-5",
          "reasoning_effort": "xhigh",
          "role": "child"
        }
      },
      {
        "tool": "create_thread",
        "arguments": {
          "request_id": "right-child",
          "cwd": "${HOME}",
          "prompt": "READY",
          "model": "anthropic/claude-opus-5-5",
          "reasoning_effort": "xhigh",
          "role": "child"
        }
      }
    ]
  },
  "expect": {
    "exit": 0,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "results",
          0,
          "structured",
          "executionPolicy",
          "mode"
        ],
        "value": "presence_only"
      },
      {
        "kind": "eq",
        "path": [
          "results",
          0,
          "structured",
          "executionPolicy",
          "roles",
          "child"
        ],
        "value": {
          "role": "child",
          "expectation": "pair",
          "model": "anthropic/claude-opus-5-5",
          "reasoningEffort": "xhigh"
        }
      },
      {
        "kind": "eq",
        "path": [
          "results",
          1,
          "error"
        ],
        "value": true
      },
      {
        "kind": "contains",
        "path": [
          "results",
          1,
          "content",
          0,
          "text"
        ],
        "value": "execution_role_mismatch"
      },
      {
        "kind": "eq",
        "path": [
          "results",
          2,
          "error"
        ],
        "value": false
      },
      {
        "kind": "same",
        "path": [
          "results",
          0,
          "structured",
          "executionPolicy",
          "digest"
        ],
        "other": [
          "results",
          2,
          "structured",
          "executionPolicy",
          "digest"
        ]
      },
      {
        "kind": "length",
        "path": [
          "calls"
        ],
        "value": 2
      }
    ]
  }
}
