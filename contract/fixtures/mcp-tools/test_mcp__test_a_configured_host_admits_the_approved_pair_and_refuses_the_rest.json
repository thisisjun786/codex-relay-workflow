{
  "given": {
    "files": {
      "policy.json": "{\"allowed\": [{\"model\": \"anthropic/claude-opus-5\", \"efforts\": [\"xhigh\"]}]}"
    }
  },
  "run": {
    "kind": "mcp",
    "env": {
      "CODEX_THREAD_BRIDGE_EXECUTION_POLICY": "${HOME}/policy.json"
    },
    "steps": [
      {
        "tool": "get_capabilities"
      },
      {
        "tool": "create_thread",
        "arguments": {
          "request_id": "approved",
          "cwd": "${HOME}",
          "prompt": "READY",
          "model": "anthropic/claude-opus-5",
          "reasoning_effort": "xhigh"
        }
      },
      {
        "tool": "create_thread",
        "arguments": {
          "request_id": "refused",
          "cwd": "${HOME}",
          "prompt": "READY",
          "model": "openai/gpt-6-astra",
          "reasoning_effort": "high"
        }
      }
    ]
  },
  "expect": {
    "exit": 0,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "results",
          0,
          "structured",
          "executionPolicy",
          "mode"
        ],
        "value": "allowlist"
      },
      {
        "kind": "eq",
        "path": [
          "results",
          1,
          "error"
        ],
        "value": false
      },
      {
        "kind": "eq",
        "path": [
          "results",
          2,
          "error"
        ],
        "value": true
      },
      {
        "kind": "contains",
        "path": [
          "results",
          2,
          "content",
          0,
          "text"
        ],
        "value": "execution_not_allowed"
      },
      {
        "kind": "length",
        "path": [
          "calls"
        ],
        "value": 2
      }
    ]
  }
}
