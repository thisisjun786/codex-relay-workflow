{
  "given": {
    "relay": {
      "delay": 30
    },
    "settings_overrides": {
      "timeoutSeconds": 1,
      "owner": null,
      "adapterInterpreter": null,
      "adapterEntryPoint": null
    }
  },
  "run": {
    "kind": "stop",
    "stdin": {
      "session_id": "s-1",
      "turn_id": "t-1",
      "cwd": "/tmp/workspace",
      "stop_hook_active": false
    }
  },
  "expect": {
    "exit": 0,
    "checks": [
      {
        "kind": "eq",
        "path": [
          "stdout"
        ],
        "value": ""
      },
      {
        "kind": "length",
        "path": [
          "rows"
        ],
        "value": 1
      },
      {
        "kind": "eq",
        "path": [
          "rows",
          0,
          "adapterOutcome"
        ],
        "value": "guard_timed_out"
      }
    ]
  }
}
